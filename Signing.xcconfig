// Code-signing settings for the generated project.
//
// The .xcodeproj is generated by XcodeGen and not committed, so a team picked in
// Xcode's Signing & Capabilities editor is lost on the next `xcodegen generate`
// and device builds start failing with "requires a development team". This file
// is what survives regeneration.
//
// Simulator builds need nothing here. To build on a device, create
// `Signing.local.xcconfig` (gitignored) next to this file containing:
//
//     DEVELOPMENT_TEAM = YOURTEAMID
//
// Find your team identifier in Xcode → Settings → Accounts → your Apple ID, or
// with `security find-identity -v -p codesigning`.

DEVELOPMENT_TEAM =

// Optional: absent on a fresh clone, and `#include?` skips it silently rather
// than failing the build, so simulator-only work needs no setup at all.
#include? "Signing.local.xcconfig"
